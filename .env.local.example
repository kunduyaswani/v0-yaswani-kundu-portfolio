# EmailJS Configuration
# Follow these steps to get your credentials:
#
# 1. Go to https://www.emailjs.com
# 2. Sign up for a free account
# 3. In the dashboard:
#    - Copy your PUBLIC_KEY from Account > API Keys section
#    - Create an Email Service (Gmail recommended)
#    - Copy the SERVICE_ID from the service details
#    - Create an Email Template
#    - Copy the TEMPLATE_ID from the template details
#
# Template Variables (use these exact names in your template):
# - {{from_name}} - Sender's name
# - {{from_email}} - Sender's email
# - {{message}} - The message body
# - {{submission_date}} - Date and time of submission
# - {{to_email}} - Your email address (recipient)
#
# Example Template HTML:
# <p>New contact from: {{from_name}} ({{from_email}})</p>
# <p>Message: {{message}}</p>
# <p>Received at: {{submission_date}}</p>

# Your EmailJS Public Key (from Account > API Keys)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Service ID (from Email Service section)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID (from Email Templates section)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here

# Your email address where you want to receive messages
NEXT_PUBLIC_CONTACT_EMAIL=your_email@example.com
